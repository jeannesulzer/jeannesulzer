diff --git a/supabase/functions/_shared/auth.ts b/supabase/functions/_shared/auth.ts
new file mode 100644
index 0000000..839235c
--- /dev/null
+++ b/supabase/functions/_shared/auth.ts
@@ -0,0 +1,85 @@
+// Authorisation helpers for the write-path edge functions.
+//
+// Every function that writes to news_articles or spends money (Firecrawl,
+// the AI gateway) must be reachable ONLY by:
+//   - the scheduler, which presents the CRON_SECRET shared secret, or
+//   - a signed-in admin/editor, proven by their own JWT.
+//
+// The Supabase anon key is a valid JWT and is published in the browser bundle,
+// so `verify_jwt = true` alone does NOT restrict a function to staff: any
+// visitor can present it. These helpers are what actually close the door.
+
+import { createClient } from "https://esm.sh/@supabase/supabase-js@2.45.0";
+
+/** Constant-time string compare — avoids leaking the secret byte by byte. */
+function safeEqual(a: string, b: string): boolean {
+  if (a.length !== b.length) return false;
+  let diff = 0;
+  for (let i = 0; i < a.length; i++) diff |= a.charCodeAt(i) ^ b.charCodeAt(i);
+  return diff === 0;
+}
+
+/** True when the request carries the scheduler's shared secret. */
+export function hasCronSecret(req: Request): boolean {
+  const expected = Deno.env.get("CRON_SECRET");
+  if (!expected) return false; // unset secret must never mean "allow"
+  const got = req.headers.get("x-cron-secret");
+  return typeof got === "string" && safeEqual(got, expected);
+}
+
+/**
+ * True when the Authorization header is a signed-in user holding `admin` or
+ * `editor`. Returns false for the anon key, which carries no user identity.
+ */
+export async function isStaff(req: Request): Promise<boolean> {
+  const authHeader = req.headers.get("Authorization");
+  if (!authHeader?.startsWith("Bearer ")) return false;
+
+  const url = Deno.env.get("SUPABASE_URL");
+  const anonKey = Deno.env.get("SUPABASE_ANON_KEY");
+  const serviceKey = Deno.env.get("SUPABASE_SERVICE_ROLE_KEY");
+  if (!url || !anonKey || !serviceKey) return false;
+
+  // Resolve the caller with THEIR token. The anon key yields no user here.
+  const asCaller = createClient(url, anonKey, {
+    global: { headers: { Authorization: authHeader } },
+    auth: { persistSession: false },
+  });
+  const { data: { user }, error } = await asCaller.auth.getUser();
+  if (error || !user) return false;
+
+  // Read the role with the service key: user_roles is not readable by anon.
+  const asService = createClient(url, serviceKey, { auth: { persistSession: false } });
+  const { data: roles } = await asService
+    .from("user_roles")
+    .select("role")
+    .eq("user_id", user.id)
+    .in("role", ["admin", "editor"])
+    .limit(1);
+
+  return !!roles && roles.length > 0;
+}
+
+/**
+ * Gate for a write-path function. Resolves to `null` when the caller is
+ * allowed, or to the 401/403 Response to return when they are not.
+ */
+export async function requireCronOrStaff(
+  req: Request,
+  corsHeaders: Record<string, string>,
+): Promise<Response | null> {
+  if (hasCronSecret(req)) return null;
+  if (await isStaff(req)) return null;
+
+  return new Response(
+    JSON.stringify({ error: "Forbidden: admin/editor session or cron secret required" }),
+    { status: 403, headers: { ...corsHeaders, "Content-Type": "application/json" } },
+  );
+}
+
+/** Clamp a caller-supplied integer into a safe range. */
+export function clampInt(value: unknown, min: number, max: number, fallback: number): number {
+  const n = typeof value === "number" ? Math.floor(value) : NaN;
+  if (!Number.isFinite(n)) return fallback;
+  return Math.min(max, Math.max(min, n));
+}
