diff --git a/src/test/published-date.test.ts b/src/test/published-date.test.ts
new file mode 100644
index 0000000..9c94d29
--- /dev/null
+++ b/src/test/published-date.test.ts
@@ -0,0 +1,56 @@
+import { describe, it, expect } from "vitest";
+import { extractPublishedDate } from "../../supabase/functions/_shared/published-date";
+
+// published_date feeds the citations rendered by /cite. The contract these
+// tests defend: report the page's own date, or report nothing. Never invent one.
+describe("extractPublishedDate", () => {
+  const NOW = Date.parse("2026-09-19T12:00:00Z");
+
+  it("returns null when there is no metadata", () => {
+    expect(extractPublishedDate(undefined, NOW)).toBeNull();
+    expect(extractPublishedDate(null, NOW)).toBeNull();
+    expect(extractPublishedDate({}, NOW)).toBeNull();
+  });
+
+  it("never substitutes the current date for a missing one", () => {
+    // The regression this whole change exists for.
+    expect(extractPublishedDate({ title: "A report" }, NOW)).toBeNull();
+  });
+
+  it("reads the publication date from the page metadata", () => {
+    expect(extractPublishedDate({ publishedTime: "2024-03-11T09:30:00Z" }, NOW))
+      .toBe("2024-03-11T09:30:00.000Z");
+  });
+
+  it("accepts the Open Graph and schema.org spellings", () => {
+    expect(extractPublishedDate({ "article:published_time": "2023-11-02" }, NOW))
+      .toBe("2023-11-02T00:00:00.000Z");
+    expect(extractPublishedDate({ datePublished: "2022-01-15T00:00:00+01:00" }, NOW))
+      .toBe("2022-01-14T23:00:00.000Z");
+  });
+
+  it("prefers the more trustworthy key when several are present", () => {
+    const meta = { date: "2019-01-01", publishedTime: "2024-06-06T10:00:00Z" };
+    expect(extractPublishedDate(meta, NOW)).toBe("2024-06-06T10:00:00.000Z");
+  });
+
+  it("skips unparseable values and falls through to the next key", () => {
+    const meta = { publishedTime: "not a date", datePublished: "2025-02-02T08:00:00Z" };
+    expect(extractPublishedDate(meta, NOW)).toBe("2025-02-02T08:00:00.000Z");
+  });
+
+  it("rejects dates before the web and dates in the future", () => {
+    expect(extractPublishedDate({ publishedTime: "1970-01-01T00:00:00Z" }, NOW)).toBeNull();
+    expect(extractPublishedDate({ publishedTime: "2031-01-01T00:00:00Z" }, NOW)).toBeNull();
+  });
+
+  it("tolerates a page published minutes ago against a skewed clock", () => {
+    expect(extractPublishedDate({ publishedTime: "2026-09-19T12:05:00Z" }, NOW))
+      .toBe("2026-09-19T12:05:00.000Z");
+  });
+
+  it("ignores non-string values", () => {
+    expect(extractPublishedDate({ publishedTime: 1700000000 }, NOW)).toBeNull();
+    expect(extractPublishedDate({ publishedTime: "   " }, NOW)).toBeNull();
+  });
+});
