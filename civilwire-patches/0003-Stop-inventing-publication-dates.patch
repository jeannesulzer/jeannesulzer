@@ -0,0 +1,50 @@
+// Publication-date extraction, kept free of Deno globals and imports so the
+// browser test suite can exercise it directly (src/test/published-date.test.ts).
+//
+// This is integrity-critical: /cite renders formal citations from published_date,
+// so a wrong value here becomes a wrong date in someone's footnote. The rule is
+// that an unknown date stays null — never today's date, never the scrape time.
+
+/** Metadata keys publishers actually use, in order of trustworthiness. */
+export const PUBLISHED_DATE_KEYS = [
+  "publishedTime",
+  "article:published_time",
+  "og:article:published_time",
+  "datePublished",
+  "dateCreated",
+  "date",
+] as const;
+
+/** Nothing on the web predates this; anything earlier is a parsing artefact. */
+const EARLIEST_PLAUSIBLE_YEAR = 1995;
+/** Clock skew allowance for "published just now" pages. */
+const FUTURE_TOLERANCE_MS = 24 * 3600 * 1000;
+
+/**
+ * The article's own publication date as an ISO string, or null when the page
+ * does not state one we can trust.
+ *
+ * @param metadata scraper-supplied page metadata (Firecrawl `result.metadata`)
+ * @param now injectable clock, for tests
+ */
+export function extractPublishedDate(
+  metadata: Record<string, unknown> | undefined | null,
+  now: number = Date.now(),
+): string | null {
+  if (!metadata) return null;
+
+  for (const key of PUBLISHED_DATE_KEYS) {
+    const raw = metadata[key];
+    if (typeof raw !== "string") continue;
+    const trimmed = raw.trim();
+    if (!trimmed) continue;
+
+    const parsed = new Date(trimmed);
+    if (isNaN(parsed.getTime())) continue;
+    if (parsed.getUTCFullYear() < EARLIEST_PLAUSIBLE_YEAR) continue;
+    if (parsed.getTime() > now + FUTURE_TOLERANCE_MS) continue;
+
+    return parsed.toISOString();
+  }
+  return null;
+}
