   const [langOpen, setLangOpen] = useState(false);
   const [navQuery, setNavQuery] = useState("");
   const navigate = useNavigate();
+  const location = useLocation();
   const debounceRef = useRef<ReturnType<typeof setTimeout>>();
 
+  // The navbar renders on ten pages but only Index passes `onSearch`, and the
+  // anchors it scrolls to (#news-feed, #filter-bar) exist only there. Everywhere
+  // else, search and the Regions/Themes/Directory links silently did nothing.
+  // Off the feed we navigate to it instead — Index already reads q/theme/region/
+  // country from the URL and syncs its filters back to them.
+  const onFeedPage = location.pathname === "/" || location.pathname === "/search";
+
   const handleSearchChange = useCallback((value: string) => {
     setNavQuery(value);
     if (debounceRef.current) clearTimeout(debounceRef.current);
     debounceRef.current = setTimeout(() => {
-      onSearch?.(value);
-      if (value.length > 0) {
-        document.getElementById("news-feed")?.scrollIntoView({ behavior: "smooth" });
+      if (onFeedPage && onSearch) {
+        onSearch(value);
+        if (value.length > 0) {
+          document.getElementById("news-feed")?.scrollIntoView({ behavior: "smooth" });
+        }
+        return;
       }
+      if (!value.trim()) return;
+      // `replace` so a search typed letter by letter leaves one history entry.
+      navigate(`/?q=${encodeURIComponent(value.trim())}`, { replace: true });
     }, 300);
-  }, [onSearch]);
+  }, [onSearch, onFeedPage, navigate]);
+
+  // Publish the header's real height as --header-h so anything sticking below it
+  // (FilterBar) can sit flush without hard-coding a pixel value. The header is
+  // three stacked rows and grows further when the mobile menu opens, so any
+  // constant is wrong at some viewport: FilterBar used top-[88px] against a
+  // 134px header and spent its life hidden behind it.
+  const headerRef = useRef<HTMLElement>(null);
+  useEffect(() => {
+    const el = headerRef.current;
+    if (!el) return;
+    const publish = () => {
+      document.documentElement.style.setProperty("--header-h", `${Math.round(el.getBoundingClientRect().height)}px`);
+    };
+    publish();
+    const ro = new ResizeObserver(publish);
+    ro.observe(el);
+    return () => ro.disconnect();
+  }, []);
+
+  /**
+   * Jump to a section of the feed, from any page. On the feed we scroll and let
+   * the panel open; elsewhere we go there first.
+   */
+  const goToFeedSection = useCallback((anchor: "filter-bar" | "news-feed", event?: { name: string; detail?: string }) => {
+    if (onFeedPage) {
+      document.getElementById(anchor)?.scrollIntoView({ behavior: "smooth" });
+      if (event) window.dispatchEvent(new CustomEvent(event.name, { detail: event.detail }));
+      return;
+    }
+    navigate("/");
+  }, [onFeedPage, navigate]);
   const { t, lang, setLang, isRTL } = useLanguage();
   const [tickerHeadlines, setTickerHeadlines] = useState<string[]>([]);
 
